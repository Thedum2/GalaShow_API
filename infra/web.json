{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "GalaShow private web buckets and HTTPS CloudFront distributions",
  "Parameters": {
    "StageName": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    },
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:us-east-1:.*"
    },
    "PolyChatRelayHost": {
      "Type": "String",
      "Default": "",
      "Description": "Function URL host of galashow-cloud-polychat-relay-<stage>; empty disables /polychat/*"
    }
  },
  "Conditions": {
    "IsDev": {
      "Fn::Equals": [
        {
          "Ref": "StageName"
        },
        "dev"
      ]
    },
    "HasPolyChatRelay": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PolyChatRelayHost"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "OriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "galashow-${StageName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SpaRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "galashow-${StageName}-spa"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Serve React routes without rewriting missing static assets",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var path = request.uri;\n  if (path.indexOf('/assets/') !== 0 && path.indexOf('/build/') !== 0 && path.indexOf('.') === -1) {\n    request.uri = '/index.html';\n  }\n  return request;\n}\n"
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "galashow-${StageName}-web"
          },
          "DefaultTTL": 0,
          "MaxTTL": 31536000,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            },
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true
          }
        }
      }
    },
    "ClientBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "galashow-${AWS::AccountId}-${StageName}-client"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "Id": "PublicSampleAssets",
              "AllowedOrigins": [
                "*"
              ],
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "AllowedHeaders": [
                "*"
              ],
              "ExposedHeaders": [
                "Accept-Ranges",
                "Content-Length",
                "Content-Range",
                "ETag"
              ],
              "MaxAge": 86400
            }
          ]
        }
      }
    },
    "ClientDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "GalaShow ${StageName} Client"
          },
          "Aliases": [
            {
              "Fn::If": [
                "IsDev",
                "dev.galashow.cloud",
                "galashow.cloud"
              ]
            }
          ],
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_200",
          "Origins": {
            "Fn::If": [
              "HasPolyChatRelay",
              [
                {
                  "Id": "web",
                  "DomainName": {
                    "Fn::GetAtt": [
                      "ClientBucket",
                      "RegionalDomainName"
                    ]
                  },
                  "OriginAccessControlId": {
                    "Ref": "OriginAccessControl"
                  },
                  "S3OriginConfig": {
                    "OriginAccessIdentity": ""
                  }
                },
                {
                  "Id": "polychat",
                  "DomainName": {
                    "Ref": "PolyChatRelayHost"
                  },
                  "CustomOriginConfig": {
                    "OriginProtocolPolicy": "https-only",
                    "OriginSSLProtocols": [
                      "TLSv1.2"
                    ],
                    "OriginReadTimeout": 60,
                    "OriginKeepaliveTimeout": 60
                  }
                }
              ],
              [
                {
                  "Id": "web",
                  "DomainName": {
                    "Fn::GetAtt": [
                      "ClientBucket",
                      "RegionalDomainName"
                    ]
                  },
                  "OriginAccessControlId": {
                    "Ref": "OriginAccessControl"
                  },
                  "S3OriginConfig": {
                    "OriginAccessIdentity": ""
                  }
                }
              ]
            ]
          },
          "DefaultCacheBehavior": {
            "TargetOriginId": "web",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "CachePolicy"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SpaRewrite",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "CertificateArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "CacheBehaviors": {
            "Fn::If": [
              "HasPolyChatRelay",
              [
                {
                  "PathPattern": "/sample-data/*",
                  "TargetOriginId": "web",
                  "ViewerProtocolPolicy": "redirect-to-https",
                  "AllowedMethods": [
                    "GET",
                    "HEAD",
                    "OPTIONS"
                  ],
                  "CachedMethods": [
                    "GET",
                    "HEAD",
                    "OPTIONS"
                  ],
                  "Compress": true,
                  "CachePolicyId": {
                    "Ref": "CachePolicy"
                  },
                  "OriginRequestPolicyId": "88a5eaf4-2fd4-4709-b370-b4c650ea3fcf",
                  "ResponseHeadersPolicyId": {
                    "Ref": "SampleAssetsCorsPolicy"
                  }
                },
                {
                  "PathPattern": "/polychat/*",
                  "TargetOriginId": "polychat",
                  "ViewerProtocolPolicy": "https-only",
                  "AllowedMethods": [
                    "GET",
                    "HEAD",
                    "OPTIONS",
                    "PUT",
                    "PATCH",
                    "POST",
                    "DELETE"
                  ],
                  "CachedMethods": [
                    "GET",
                    "HEAD"
                  ],
                  "Compress": false,
                  "CachePolicyId": {
                    "Ref": "PolyChatCachePolicy"
                  },
                  "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
                  "FunctionAssociations": [
                    {
                      "EventType": "viewer-request",
                      "FunctionARN": {
                        "Fn::GetAtt": [
                          "PolyChatPathRewrite",
                          "FunctionARN"
                        ]
                      }
                    }
                  ]
                }
              ],
              [
                {
                  "PathPattern": "/sample-data/*",
                  "TargetOriginId": "web",
                  "ViewerProtocolPolicy": "redirect-to-https",
                  "AllowedMethods": [
                    "GET",
                    "HEAD",
                    "OPTIONS"
                  ],
                  "CachedMethods": [
                    "GET",
                    "HEAD",
                    "OPTIONS"
                  ],
                  "Compress": true,
                  "CachePolicyId": {
                    "Ref": "CachePolicy"
                  },
                  "OriginRequestPolicyId": "88a5eaf4-2fd4-4709-b370-b4c650ea3fcf",
                  "ResponseHeadersPolicyId": {
                    "Ref": "SampleAssetsCorsPolicy"
                  }
                }
              ]
            ]
          }
        }
      }
    },
    "ClientBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ClientBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontRead",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${ClientBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${ClientDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ClientBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ClientBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ClientDnsA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Fn::If": [
            "IsDev",
            "dev.galashow.cloud",
            "galashow.cloud"
          ]
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "ClientDistribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "ClientDnsAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Fn::If": [
            "IsDev",
            "dev.galashow.cloud",
            "galashow.cloud"
          ]
        },
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "ClientDistribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "AdminBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "galashow-${AWS::AccountId}-${StageName}-admin"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        }
      }
    },
    "AdminDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": {
            "Fn::Sub": "GalaShow ${StageName} Admin"
          },
          "Aliases": [
            {
              "Fn::If": [
                "IsDev",
                "admin-dev.galashow.cloud",
                "admin.galashow.cloud"
              ]
            }
          ],
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_200",
          "Origins": [
            {
              "Id": "web",
              "DomainName": {
                "Fn::GetAtt": [
                  "AdminBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccessControl"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "web",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "CachePolicy"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SpaRewrite",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "CertificateArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          }
        }
      }
    },
    "AdminBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AdminBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontRead",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${AdminBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${AdminDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AdminBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AdminBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "AdminDnsA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Fn::If": [
            "IsDev",
            "admin-dev.galashow.cloud",
            "admin.galashow.cloud"
          ]
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "AdminDistribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "AdminDnsAAAA": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Fn::If": [
            "IsDev",
            "admin-dev.galashow.cloud",
            "admin.galashow.cloud"
          ]
        },
        "Type": "AAAA",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "AdminDistribution",
              "DomainName"
            ]
          },
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "EvaluateTargetHealth": false
        }
      }
    },
    "SampleAssetsCorsPolicy": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "galashow-${StageName}-sample-assets-cors"
          },
          "Comment": "Public sample assets (PDF, images, video) readable by fetch from any origin without credentials",
          "CorsConfig": {
            "AccessControlAllowCredentials": false,
            "AccessControlAllowHeaders": {
              "Items": [
                "*"
              ]
            },
            "AccessControlAllowMethods": {
              "Items": [
                "GET",
                "HEAD",
                "OPTIONS"
              ]
            },
            "AccessControlAllowOrigins": {
              "Items": [
                "*"
              ]
            },
            "AccessControlExposeHeaders": {
              "Items": [
                "Accept-Ranges",
                "Content-Length",
                "Content-Range",
                "ETag"
              ]
            },
            "AccessControlMaxAgeSec": 86400,
            "OriginOverride": true
          }
        }
      }
    },
    "PolyChatPathRewrite": {
      "Type": "AWS::CloudFront::Function",
      "Condition": "HasPolyChatRelay",
      "Properties": {
        "Name": {
          "Fn::Sub": "galashow-${StageName}-polychat"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Strip the /polychat mount before forwarding to the relay",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  request.uri = request.uri.substring(9) || '/';\n  return request;\n}\n"
      }
    },
    "PolyChatCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Condition": "HasPolyChatRelay",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "galashow-${StageName}-polychat"
          },
          "Comment": "Never cache; Authorization is in the key so CloudFront forwards it",
          "DefaultTTL": 0,
          "MaxTTL": 1,
          "MinTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "whitelist",
              "Headers": [
                "Authorization"
              ]
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "all"
            },
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false
          }
        }
      }
    }
  },
  "Outputs": {
    "ClientBucket": {
      "Value": {
        "Ref": "ClientBucket"
      }
    },
    "ClientDistributionId": {
      "Value": {
        "Ref": "ClientDistribution"
      }
    },
    "ClientUrl": {
      "Value": {
        "Fn::If": [
          "IsDev",
          "https://dev.galashow.cloud",
          "https://galashow.cloud"
        ]
      }
    },
    "AdminBucket": {
      "Value": {
        "Ref": "AdminBucket"
      }
    },
    "AdminDistributionId": {
      "Value": {
        "Ref": "AdminDistribution"
      }
    },
    "AdminUrl": {
      "Value": {
        "Fn::If": [
          "IsDev",
          "https://admin-dev.galashow.cloud",
          "https://admin.galashow.cloud"
        ]
      }
    }
  }
}
